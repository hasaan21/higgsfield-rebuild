{
  "name": "higgsfield-rebuild",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "media": "bash scripts/gen-media.sh",
    "check:margins": "tsx scripts/check-margins.ts",
    "dev:worker": "mkdir -p out && wrangler dev --port 8787",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.3",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.148.0"
  },
  "packageManager": "pnpm@10.10.0"
}
