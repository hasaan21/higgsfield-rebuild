# Copy to .dev.vars for `wrangler dev`; in production set each with `wrangler secret put NAME`.
# Any vendor key left empty makes that vendor's models run on the mock engine (still billed in credits).

# Overrides the `SUPABASE_URL` var in wrangler.jsonc for local runs. The backend stays off until this and the service role key are set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still on the legacy shared JWT secret; otherwise tokens are checked against the project's JWKS.
SUPABASE_JWT_SECRET=
# Any long random string; signs short-lived media links.
MEDIA_SIGNING_SECRET=

KLING_API_KEY=
GEMINI_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_ULTRA=
